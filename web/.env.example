# Address of the deployed Launchpad contract (from `forge script script/Deploy.s.sol`).
# While unset/zero, the app runs on its built-in mock-data layer.
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000

# --- Coil v4 deployments, per chain ---
# CONVENTION: the default chain (Robinhood Chain, 4663) keeps the unprefixed names it has always
# used; every other chain takes the same name behind its chain prefix. Next.js inlines NEXT_PUBLIC_*
# only at literal `process.env.X` sites, so each one is spelled out in lib/contracts.ts — adding a
# chain means adding its block there too, not just here.
#
# An address left unset is a distinct state from zero: it means "not deployed on this chain", and the
# UI degrades to exactly the routes that chain can serve (no launch button, no swap tab) rather than
# offering something that would revert.
NEXT_PUBLIC_COIL_LAUNCHPAD=
NEXT_PUBLIC_COIL_SWAP_ROUTER=
NEXT_PUBLIC_COIL_BURNER=
NEXT_PUBLIC_COIL_TOKEN=

# Arc (5042). Gas is native USDC, which the EVM scales to 18 decimals — so creation fees and every
# `value` on Arc use the same 18-decimal math as an ETH chain (2 USDC is 2e18, NOT 2e6).
NEXT_PUBLIC_ARC_COIL_LAUNCHPAD=
NEXT_PUBLIC_ARC_COIL_SWAP_ROUTER=
NEXT_PUBLIC_ARC_COIL_BURNER=
NEXT_PUBLIC_ARC_COIL_TOKEN=

# Uniswap v4 PoolManager per chain — every v4 pool and Swap event lives in this singleton, so the
# charts and the swap route read from it. Uniswap deploys v4 chain by chain and NOT at matching
# addresses; see contracts-v4/README.md ("Infra Uniswap v4 por chain") before copying one across.
NEXT_PUBLIC_ARC_V4_POOL_MANAGER=

# Optional per-chain RPC overrides. Public defaults ship in lib/chain.ts, so reads work unset.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=

# --- Listing filters (optional) ---
# Hide specific tokens from the listings (home / trending / stats). Comma-separated addresses.
# The tokens still exist on-chain and their /token/<address> page still works.
NEXT_PUBLIC_HIDDEN_TOKENS=

# Hide every token launched BEFORE this instant — sweep old contracts off the site without a deploy.
# Accepts a unix timestamp (seconds) or a date string, e.g. `2026-07-15` or `2026-07-15T00:00:00Z`.
# Empty/unset = show everything. Only filters the lists; the /token/<address> page still works.
NEXT_PUBLIC_HIDE_TOKENS_BEFORE=

# --- Trader profiles + token chat (optional) ---
# Provision a Vercel Postgres store (Vercel dashboard → Storage → Create → Postgres) and link it to
# the project; Vercel injects POSTGRES_URL automatically. Until it's set, profiles/chat read as empty
# and writes return 503 — the rest of the site is unaffected.
POSTGRES_URL=

# Secret (any long random string, e.g. `openssl rand -hex 32`) used to sign the wallet session
# cookie. Required for sign-in / posting. Keep it private (do NOT prefix with NEXT_PUBLIC_).
AUTH_SECRET=
